# Core settings
VLM_PROVIDER=GEMINI
VLM_API_KEY=YOUR-API-KEY
VLM_MODEL=gemini-2.5-pro
# Configuration for the local-client mode of blender 
BLENDER_MODE=headless
BLENDER_HOST=localhost
BLENDER_PORT=9876
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=9877
BLENDER_HEADLESS_STARTUP_TIMEOUT=10
HEADLESS_REQUEST_TIMEOUT_SECONDS=15
REFERENCE_IMAGE_MAX_COUNT=3
REFERENCE_IMAGE_MAX_BYTES=10485760
REFERENCE_IMAGE_STORAGE_DIR=/tmp/scene_agent_reference_images
RAG_ENABLED=false

# API runtime
API_WORKERS=4
API_STREAM_TIMEOUT_SECONDS=120

# Headless + MCP process management
BLENDER_HEADLESS_CMD=blender
BLENDER_HEADLESS_ARGS=--background --python scripts/blender_headless_client.py -- --host {host} --port {port}
BLENDER_HEADLESS_LOG_DIR=/tmp/scene_agent_headless_logs
BLENDER_HEADLESS_HOST=localhost
BLENDER_HEADLESS_BASE_PORT=9876
BLENDER_HEADLESS_PORT_RANGE=16
BLENDER_MCP_HOST=localhost
BLENDER_MCP_BASE_PORT=9877
BLENDER_MCP_PORT_RANGE=16
BLENDER_MCP_CMD=python
BLENDER_MCP_ARGS=mcp_server/server.py
BLENDER_MCP_LOG_DIR=/tmp/scene_agent_mcp_logs
BLENDER_MCP_STARTUP_TIMEOUT=10

# Blender headless client script
BLENDER_ADDON_MODULE=blender_mcpv_addon
BLENDER_ADDON_START_OP=
BLENDER_HEADLESS_PORT=9876

# Service integrations
RETRIEVAL_API_HOST=localhost
RETRIEVAL_API_PORT=8002
TRELLIS2_HOST=localhost
TRELLIS2_PORT=8001
INFINIGEN_HOST=localhost
INFINIGEN_PORT=8003