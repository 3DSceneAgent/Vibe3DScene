# Core settings
VLM_PROVIDER=GEMINI
VLM_API_KEY=YOUR-API-KEY
VLM_MODEL=gemini-2.5-pro
# Configuration for the local-client mode of blender 
BLENDER_MODE=headless
BLENDER_HOST=localhost
BLENDER_PORT=9876
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=9877
BLENDER_HEADLESS_STARTUP_TIMEOUT=10
HEADLESS_REQUEST_TIMEOUT_SECONDS=15
REFERENCE_IMAGE_MAX_COUNT=3
REFERENCE_IMAGE_MAX_BYTES=10485760
REFERENCE_IMAGE_STORAGE_DIR=/tmp/scene_agent_reference_images
RAG_ENABLED=false

# API runtime
API_WORKERS=4
API_STREAM_TIMEOUT_SECONDS=120

# Headless + MCP process management
BLENDER_HEADLESS_CMD=blender
BLENDER_HEADLESS_ARGS=--background --python scripts/blender_headless_client.py -- --host {host} --port {port}
BLENDER_HEADLESS_LOG_DIR=/tmp/scene_agent_headless_logs
BLENDER_HEADLESS_HOST=localhost
BLENDER_HEADLESS_BASE_PORT=9876
BLENDER_HEADLESS_PORT_RANGE=16
BLENDER_MCP_HOST=localhost
BLENDER_MCP_BASE_PORT=9877
BLENDER_MCP_PORT_RANGE=16
BLENDER_MCP_CMD=python
BLENDER_MCP_ARGS=mcp_server/server.py
BLENDER_MCP_LOG_DIR=/tmp/scene_agent_mcp_logs
BLENDER_MCP_STARTUP_TIMEOUT=10

# Session durability (headless)
SESSION_BLEND_ROOT=/tmp/scene_agent_sessions
SESSION_IDLE_TIMEOUT_SECONDS=600
SESSION_SWEEP_INTERVAL_SECONDS=30
SESSION_MAX_SNAPSHOTS=20
SESSION_PERSISTENCE_ENABLED=1

# Blender headless client script
BLENDER_ADDON_MODULE=blender_mcpv_addon
BLENDER_ADDON_START_OP=
BLENDER_HEADLESS_PORT=9876

# Service integrations
TRELLIS2_HOST=localhost
TRELLIS2_PORT=8001
RETRIEVAL_API_HOST=localhost
RETRIEVAL_API_PORT=8002
INFINIGEN_HOST=localhost
INFINIGEN_PORT=8003

# Conditional tool switches
# - Rodin tools are enabled only when BLENDER_MODE=local-client and ENABLE_RODIN=true
# - Hunyuan tools are enabled only when BLENDER_MODE=headless and ENABLE_HUNYUAN=true
# - TRELLIS2 tool is enabled only when BLENDER_MODE=headless and ENABLE_TRELLIS2=true
# - Retrieval tools are enabled only when ENABLE_RETRIEVAL=true
# - Infinigen tools are enabled only when ENABLE_INFINIGEN=true
# - Sketchfab tools are enabled only when ENABLE_SKETCHFAB=true and SKETCHFAB_API_KEY is set
# - Invalid combinations fail MCP startup:
#   * ENABLE_HUNYUAN=true and ENABLE_TRELLIS2=true
#   * ENABLE_RETRIEVAL=true and ENABLE_SKETCHFAB=true
ENABLE_RODIN=false
ENABLE_HUNYUAN=false
ENABLE_TRELLIS2=false
ENABLE_RETRIEVAL=false
ENABLE_INFINIGEN=false
ENABLE_SKETCHFAB=false

# Sketchfab credentials (server-side calls from mcp_server)
SKETCHFAB_API_KEY=

# Hunyuan official API credentials (server-side call from mcp_server)
HUNYUAN3D_SECRET_ID=
HUNYUAN3D_SECRET_KEY=
HUNYUAN3D_REGION=ap-guangzhou
HUNYUAN3D_TIMEOUT_SECONDS=300
HUNYUAN3D_POLL_INTERVAL_SECONDS=5
