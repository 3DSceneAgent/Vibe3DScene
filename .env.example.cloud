# Copy to .env for a cloud-backed asset workflow.
# Target stack:
# - Sketchfab (authenticated API)
# - PolyHaven (public HTTP source; always available)
# - Hyper3D Rodin (authenticated API)
#
# Notes:
# - Retrieval is disabled here because MCP currently treats
#   ENABLE_RETRIEVAL=true and ENABLE_SKETCHFAB=true as an invalid combination.
# - TRELLIS2 is disabled here to avoid generator conflicts and to keep the
#   profile focused on cloud-backed sources.

# Core VLM settings
VLM_PROVIDER=GEMINI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
VLM_MODEL=gemini-2.5-pro

# Blender / MCP runtime
BLENDER_MODE=headless
BLENDER_HOST=localhost
BLENDER_PORT=9876
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=9877

# API runtime
API_PORT=8000
API_WORKERS=1
REDIS_URL=redis://localhost:6379/0

# Headless + MCP process management
BLENDER_HEADLESS_CMD=blender
BLENDER_HEADLESS_ARGS=--background --python scripts/blender_headless_client.py -- --host {host} --port {port}
BLENDER_HEADLESS_LOG_DIR=/tmp/scene_agent_headless_logs
BLENDER_MCP_CMD=python
BLENDER_MCP_ARGS=mcp_server/server.py
BLENDER_MCP_LOG_DIR=/tmp/scene_agent_mcp_logs

# Session durability
SESSION_SHARED_STORAGE_ROOT=/tmp/scene_agent_sessions
SESSION_BLEND_ROOT=/tmp/scene_agent_sessions
SESSION_IDLE_TIMEOUT_SECONDS=180
SESSION_SWEEP_INTERVAL_SECONDS=10
SESSION_MAX_SNAPSHOTS=20
SESSION_PERSISTENCE_ENABLED=1

# Service endpoints
TRELLIS2_HOST=localhost
TRELLIS2_PORT=8001
RETRIEVAL_API_HOST=localhost
RETRIEVAL_API_PORT=8002
RETRIEVAL_PROVIDER=assetretrieval3d
SCENESMITH_ENABLE_HSSD=false
SCENESMITH_ENABLE_AMBIENTCG=false
INFINIGEN_HOST=localhost
INFINIGEN_PORT=8003
SAM_HTTP_BASE_URL=http://127.0.0.1:8004

# Conditional tool switches
ENABLE_HUNYUAN=false
ENABLE_TRELLIS2=false
ENABLE_RETRIEVAL=false
ENABLE_INFINIGEN=false
ENABLE_SAM_RECONSTRUCT=false
ENABLE_SKETCHFAB=true
ENABLE_RODIN=true

# Required cloud credentials
RODIN_API_KEY=
SKETCHFAB_API_KEY=
SKETCHFAB_API_BASE_URL=https://api.sketchfab.com/v3

# Optional Hunyuan credentials left empty in this profile
HUNYUAN3D_SECRET_ID=
HUNYUAN3D_SECRET_KEY=
HUNYUAN3D_REGION=ap-guangzhou
