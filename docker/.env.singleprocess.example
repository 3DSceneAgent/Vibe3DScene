# Copy this file to docker/.env.singleprocess before starting docker compose.
# This single-process Docker profile targets linux/amd64 only.

# Required model provider and key(s)
VLM_PROVIDER=gemini
OPENAI_API_KEY=replace_me
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
VLM_API_KEY=
# Optional dedicated verifier model for dual-agent plan mode
DUAL_AGENT_VERIFIER_VLM_PROVIDER=
DUAL_AGENT_VERIFIER_VLM_MODEL=

# Optional outbound proxy for model providers
SCENE_AGENT_HTTP_PROXY=
SCENE_AGENT_HTTPS_PROXY=

# API runtime
API_STREAM_TIMEOUT_SECONDS=180
REDIS_URL=redis://localhost:6379/0

# Headless mode defaults
BLENDER_MODE=headless
INSTALL_BLENDER=true
BLENDER_VERSION=4.2.15
HEADLESS_REQUEST_TIMEOUT_SECONDS=15
BLENDER_HEADLESS_STARTUP_TIMEOUT=10

# Session persistence
SESSION_SHARED_STORAGE_ROOT=/var/lib/scene_agent/sessions
SESSION_BLEND_ROOT=/var/lib/scene_agent/sessions
SESSION_IDLE_TIMEOUT_SECONDS=600
SESSION_SWEEP_INTERVAL_SECONDS=30
SESSION_MAX_SNAPSHOTS=20
SESSION_PERSISTENCE_ENABLED=1

# Reference image limits
REFERENCE_IMAGE_MAX_COUNT=3
REFERENCE_IMAGE_MAX_BYTES=10485760
REFERENCE_IMAGE_STORAGE_DIR=/var/lib/scene_agent/reference_images

# Optional tool switches
ENABLE_RODIN=true
ENABLE_HUNYUAN=false
ENABLE_TRELLIS2=false
ENABLE_RETRIEVAL=false
ENABLE_INFINIGEN=false
ENABLE_SKETCHFAB=true

# Headless command
BLENDER_HEADLESS_CMD=blender
BLENDER_HEADLESS_ARGS="--background --python scripts/blender_headless_client.py -- --host {host} --port {port}"
BLENDER_HEADLESS_LOG_DIR=/var/log/scene_agent/headless

# MCP process command
BLENDER_MCP_CMD=python
BLENDER_MCP_ARGS=mcp_server/server.py
BLENDER_MCP_LOG_DIR=/var/log/scene_agent/mcp
