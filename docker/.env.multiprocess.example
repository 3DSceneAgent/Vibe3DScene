# Copy this file to docker/.env.multiprocess before starting docker compose.

# Required model provider and key(s)
VLM_PROVIDER=openai
OPENAI_API_KEY=replace_me
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VLM_API_KEY=

# API runtime
API_STREAM_TIMEOUT_SECONDS=120

# Multiprocess ownership/lease
REDIS_KEY_PREFIX=sa
SESSION_LEASE_TTL_SECONDS=20
SESSION_HEARTBEAT_INTERVAL_SECONDS=5
SESSION_OWNER_UNREACHABLE_GRACE_SECONDS=10

# Headless mode (multiprocess routing currently targets headless)
BLENDER_MODE=headless
INSTALL_BLENDER=true
# Docker workers are pinned to linux/amd64 and only install linux-x86-64 Blender.
BLENDER_VERSION=4.2.15
HEADLESS_REQUEST_TIMEOUT_SECONDS=15
BLENDER_HEADLESS_STARTUP_TIMEOUT=10

# Reference image limits
REFERENCE_IMAGE_MAX_COUNT=3
REFERENCE_IMAGE_MAX_BYTES=10485760

# Optional tool switches
ENABLE_RODIN=false
ENABLE_HUNYUAN=false
ENABLE_TRELLIS2=false
ENABLE_RETRIEVAL=false
ENABLE_INFINIGEN=false
ENABLE_SKETCHFAB=false

# Headless command.
# If INSTALL_BLENDER=false during image build, replace this with a valid executable in the container.
BLENDER_HEADLESS_CMD=blender
BLENDER_HEADLESS_ARGS="--background --python scripts/blender_headless_client.py -- --host {host} --port {port}"

# MCP process command
BLENDER_MCP_CMD=python
BLENDER_MCP_ARGS=mcp_server/server.py
