# Copy to .env for a local, self-hosted tool stack.
# Target stack:
# - TRELLIS2 (local)
# - SceneSmith retrieval (HSSD + AmbientCG) (local)
# - PolyHaven (public HTTP source; can be disabled with ENABLE_POLYHAVEN=false)
#
# Notes:
# - Root runtime gates SceneSmith via ASSET_RETRIEVAL_BACKEND=scenesmith
#   plus the optional ENABLE_AMBIENTCG flag.
# - HSSD / AmbientCG themselves are started by ../3DAgentTools/SceneSmithRetrieval.
# - To actually serve HSSD + AmbientCG, also configure ../3DAgentTools/.env with:
#   ASSET_RETRIEVAL_BACKEND=scenesmith
#   SCENESMITH_COMPAT_PORT=8005
#   ENABLE_AMBIENTCG=true

# Core VLM settings
VLM_PROVIDER=GEMINI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
VLM_MODEL=gemini-2.5-pro

# Blender / MCP runtime
BLENDER_MODE=headless
BLENDER_HOST=localhost
BLENDER_PORT=9876
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=9877

# API runtime
API_PORT=8000
API_WORKERS=1
FAST_MODE_DEFAULT=false
REDIS_URL=redis://localhost:6379/0

# Headless + MCP process management
BLENDER_HEADLESS_CMD=blender
BLENDER_HEADLESS_ARGS=--background --python scripts/blender_headless_client.py -- --host {host} --port {port}
BLENDER_HEADLESS_LOG_DIR=/tmp/scene_agent_headless_logs
BLENDER_MCP_CMD=python
BLENDER_MCP_ARGS=mcp_server/server.py
BLENDER_MCP_LOG_DIR=/tmp/scene_agent_mcp_logs

# Session durability
SESSION_SHARED_STORAGE_ROOT=/tmp/scene_agent_sessions
SESSION_BLEND_ROOT=/tmp/scene_agent_sessions
SESSION_IDLE_TIMEOUT_SECONDS=180
SESSION_SWEEP_INTERVAL_SECONDS=10
SESSION_MAX_SNAPSHOTS=20
SESSION_PERSISTENCE_ENABLED=1

# Local tool endpoints
# Shared host/IP for self-hosted tool services when they run on the same machine.
# Examples: localhost, 127.0.0.1, 192.168.1.50, tools.internal
TOOL_SERVICE_HOST=localhost
OBJAVERSE_HOST=
OBJAVERSE_PORT=8001
# Optional per-service overrides. Leave blank to inherit TOOL_SERVICE_HOST.
TRELLIS2_HOST=
TRELLIS2_PORT=8002
# AssetRetrieval3D / Objaverse endpoint (unused in this SceneSmith profile unless you switch backends)
ASSET_RETRIEVAL_BACKEND=scenesmith
# SceneSmith compatibility API endpoint (used in this profile)
SCENESMITH_COMPAT_HOST=
SCENESMITH_COMPAT_PORT=8005
INFINIGEN_HOST=
INFINIGEN_PORT=8003
# SAMServer endpoint (default :8004)
SAM_HOST=
SAM_PORT=8004
# Optional checkout path for the external 3DAgentTools repository.
# Leave blank to use ../3DAgentTools next to this repo.
AGENT_TOOLS_ROOT=
SCENESMITH_AMBIENTCG_TEXTURE_DIR=/tmp/scene_agent_ambientcg_materials

# Conditional tool switches
ENABLE_HUNYUAN=false
ENABLE_TRELLIS2=true
ENABLE_POLYHAVEN=false
ENABLE_AMBIENTCG=true
ENABLE_INFINIGEN=false
ENABLE_SAM_RECONSTRUCT=false
ENABLE_SKETCHFAB=false
ENABLE_RODIN=false

# Cloud credentials left empty in this local profile
RODIN_API_KEY=
SKETCHFAB_API_KEY=
HUNYUAN3D_SECRET_ID=
HUNYUAN3D_SECRET_KEY=
HUNYUAN3D_REGION=ap-guangzhou
